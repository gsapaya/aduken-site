---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const publicContactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? "";
const publicContactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? "";
const publicWhatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? "";
const showConfigNotice =
  !publicContactEmail && !publicContactEndpoint && !publicWhatsappNumber &&
  import.meta.env.DEV;
---

<BaseLayout>
  <Header />
  <main>
    <section
      class="hero section-shell"
      id="producto"
      aria-labelledby="hero-title"
    >
      <div class="hero-copy">
        <p class="eyebrow">Sistema de gestión adaptable</p>
        <h1 id="hero-title">Un sistema que entiende cómo trabajás.</h1>
        <p class="lead">
          Aduken combina experiencia, acompañamiento humano e inteligencia
          aplicada para resolver las necesidades reales de tu negocio sin
          obligarte a cambiar tu forma de trabajar.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#contacto"
            >Conversemos sobre tu negocio</a
          >
          <a class="button button-secondary" href="#como-trabajamos"
            >Conocé cómo trabajamos</a
          >
        </div>
      </div>
    </section>
    <div class="hero-visual" aria-hidden="true">
      <svg viewBox="0 0 520 420" role="img">
        <rect x="64" y="44" width="392" height="332" rx="28" fill="#ffffff"
        ></rect>
        <path
          d="M128 140h84"
          stroke="#2f80ff"
          stroke-width="10"
          stroke-linecap="round"></path>
        <path
          d="M129 192h120"
          stroke="#7aaef3"
          stroke-width="10"
          stroke-linecap="round"></path>
        <path
          d="M129 244h96"
          stroke="#b96b2f"
          stroke-width="10"
          stroke-linecap="round"></path>
        <rect x="260" y="112" width="134" height="82" rx="18" fill="#f7f2ea"
        ></rect>
        <rect x="260" y="220" width="134" height="84" rx="18" fill="#eef6ff"
        ></rect>
        <path
          d="M392 154h44"
          stroke="#07111f"
          stroke-width="8"
          stroke-linecap="round"></path>
        <path
          d="M436 154v116"
          stroke="#07111f"
          stroke-width="8"
          stroke-linecap="round"></path>
        <path
          d="M436 270h-44"
          stroke="#2f80ff"
          stroke-width="8"
          stroke-linecap="round"></path>
        <circle cx="440" cy="154" r="10" fill="#2f80ff"></circle>
        <circle cx="440" cy="270" r="10" fill="#2f80ff"></circle>
        <path
          d="M260 154h-56"
          stroke="#07111f"
          stroke-width="8"
          stroke-linecap="round"></path>
        <path
          d="M204 154v116"
          stroke="#07111f"
          stroke-width="8"
          stroke-linecap="round"></path>
        <path
          d="M204 270h56"
          stroke="#07111f"
          stroke-width="8"
          stroke-linecap="round"></path>
      </svg>
    </div>
  </main>

  <section
    class="section-shell section"
    id="negocios-diferentes"
    aria-labelledby="different-title"
  >
    <div class="section-heading">
      <p class="eyebrow">Comprensión antes que acción</p>
      <h2 id="different-title">
        No creemos que todas las empresas deban trabajar igual.
      </h2>
    </div>
    <div class="comparison-grid">
      <article class="card card-contrast">
        <h3>Fábrica</h3>
        <p>Venta → Producción → Preparación → Entrega</p>
      </article>
      <article class="card card-contrast">
        <h3>Ferretería</h3>
        <p>Venta → Entrega</p>
      </article>
      <article class="card card-base">
        <h3>Aduken</h3>
        <p>
          Una base común para trabajar con claridad y adaptarse sin perder
          estabilidad.
        </p>
      </article>
    </div>
  </section>

  <section
    class="section-shell section"
    id="problema-habitual"
    aria-labelledby="problem-title"
  >
    <div class="section-heading">
      <p class="eyebrow">El problema habitual</p>
      <h2 id="problem-title">
        Cuando el sistema no entiende el trabajo, el trabajo termina rodeando al
        sistema.
      </h2>
    </div>
    <div class="problem-grid">
      <article class="card">Planillas paralelas</article>
      <article class="card">Información duplicada</article>
      <article class="card">Tareas repetidas</article>
      <article class="card">Procesos manuales</article>
      <article class="card">Personas que conocen “el truco”</article>
      <article class="card">Soporte desconectado del problema real</article>
    </div>
  </section>

  <section
    class="section-shell section"
    id="como-trabajamos"
    aria-labelledby="how-title"
  >
    <div class="section-heading">
      <p class="eyebrow">Cómo trabajamos</p>
      <h2 id="how-title">Primero entendemos. Después construimos.</h2>
    </div>
    <div class="steps-grid" role="list">
      <article class="step-card" role="listitem">
        <span>01</span>
        <h3>Escuchamos</h3>
      </article>
      <article class="step-card" role="listitem">
        <span>02</span>
        <h3>Relevamos</h3>
      </article>
      <article class="step-card" role="listitem">
        <span>03</span>
        <h3>Identificamos</h3>
      </article>
      <article class="step-card" role="listitem">
        <span>04</span>
        <h3>Proponemos</h3>
      </article>
      <article class="step-card" role="listitem">
        <span>05</span>
        <h3>Implementamos</h3>
      </article>
      <article class="step-card" role="listitem">
        <span>06</span>
        <h3>Validamos</h3>
      </article>
      <article class="step-card" role="listitem">
        <span>07</span>
        <h3>Acompañamos</h3>
      </article>
    </div>
  </section>

  <section
    class="section-shell section"
    id="historia"
    aria-labelledby="story-title"
  >
    <div class="section-heading">
      <p class="eyebrow">Experiencia real</p>
      <h2 id="story-title">
        Construido desde negocios reales y dominios complejos.
      </h2>
    </div>
    <div class="story-layout">
      <p>
        Aduken nació de años de convivir con negocios y desarrollar software
        para operaciones complejas. Aprendimos que una fábrica, una ferretería y
        una empresa industrial pueden compartir muchas necesidades y, aun así,
        trabajar de maneras completamente diferentes.
      </p>
      <blockquote>
        Adaptarse al cliente no alcanza. Cada adaptación también debe poder
        mantenerse.
      </blockquote>
    </div>
  </section>

  <section
    class="section-shell section"
    id="inteligencia"
    aria-labelledby="ai-title"
  >
    <div class="section-heading">
      <p class="eyebrow">Inteligencia aplicada</p>
      <h2 id="ai-title">
        La inteligencia artificial debería sacarte trabajo, no darte nuevas
        cosas que aprender.
      </h2>
    </div>
    <div class="ai-layout">
      <div class="ai-flow" aria-hidden="true">
        <span>Archivo Excel</span>
        <span>✓ Análisis</span>
        <span>⚑ Productos y precios</span>
        <span>↺ Alternativas</span>
        <span>✓ Confirmación humana</span>
        <span>⚙ Resultado procesado</span>
      </div>
      <p>
        Un proveedor te envía una lista de precios en Excel. Aduken analiza la
        información, identifica productos, códigos, precios e inconsistencias, y
        te presenta alternativas comprensibles sin exigir que aprendas
        estructuras técnicas.
      </p>
      <p>
        La IA también ayuda a validar cambios, ampliar pruebas y detectar
        riesgos antes de que una actualización llegue al cliente.
      </p>
    </div>
  </section>

  <section class="section-shell section" aria-labelledby="base-title">
    <div class="section-heading">
      <p class="eyebrow">Base y capacidades</p>
      <h2 id="base-title">Una base sólida para negocios que no son iguales.</h2>
    </div>
    <div class="base-layout">
      <div class="base-card">
        <h3>Base estable</h3>
        <p>Un núcleo común para ventas, clientes y operaciones esenciales.</p>
      </div>
      <div class="base-card">
        <h3>Capacidades específicas</h3>
        <ul>
          <li>orden de producción;</li>
          <li>información adicional en factura;</li>
          <li>aprobación especial;</li>
          <li>importación con reglas propias;</li>
          <li>circuito de entrega particular.</li>
        </ul>
      </div>
    </div>
    <p class="standout">
      Adaptado a tu operación. Preparado para seguir evolucionando.
    </p>
  </section>

  <section class="section-shell section" aria-labelledby="capabilities-title">
    <div class="section-heading">
      <p class="eyebrow">Capacidades del producto</p>
      <h2 id="capabilities-title">
        La gestión que necesitás, sobre una base que puede crecer.
      </h2>
    </div>
    <div class="capability-grid">
      <article class="capability-card">
        <h3>Operación comercial</h3>
        <p>Procesos de venta y seguimiento del negocio.</p>
      </article>
      <article class="capability-card">
        <h3>Productos y stock</h3>
        <p>Control y organización del catálogo y la disponibilidad.</p>
      </article>
      <article class="capability-card">
        <h3>Administración</h3>
        <p>Flujos de trabajo y estructura de información.</p>
      </article>
      <article class="capability-card">
        <h3>Tesorería</h3>
        <p>Movimientos y visibilidad de caja y cuentas corrientes.</p>
      </article>
      <article class="capability-card">
        <h3>Organización</h3>
        <p>Usuarios, sucursales y prioridades de operación.</p>
      </article>
    </div>
  </section>

  <section
    class="section-shell section proposal-section"
    aria-labelledby="proposal-title"
  >
    <div class="section-heading">
      <p class="eyebrow">Propuesta comercial</p>
      <h2 id="proposal-title">
        No queremos que elijas Aduken por una presentación.
      </h2>
    </div>
    <div class="proposal-card">
      <p>
        Queremos entender tu operación, ayudarte a utilizarlo en situaciones
        reales y que puedas evaluar si verdaderamente mejora tu trabajo. Cuando
        estés convencido de que aporta valor, hablamos del acuerdo comercial.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contacto"
          >Conversemos sobre tu negocio</a
        >
      </div>
      <p class="microcopy">
        Sin presión comercial. Sin una demo genérica. Empezamos por tu problema.
      </p>
    </div>
  </section>

  <section
    class="section-shell section"
    id="contacto"
    aria-labelledby="contact-title"
  >
    <div class="section-heading">
      <p class="eyebrow">Contacto</p>
      <h2 id="contact-title">
        ¿Qué parte de tu trabajo debería ser más simple?
      </h2>
    </div>
    <form
      class="contact-form"
      id="contact-form"
      data-contact-email={publicContactEmail}
      data-contact-endpoint={publicContactEndpoint}
      data-contact-whatsapp={publicWhatsappNumber}
    >
      <label>
        Problema o proceso
        <textarea name="problem" rows="4" required></textarea>
      </label>
      <div class="form-grid">
        <label>
          Nombre
          <input name="name" type="text" required />
        </label>
        <label>
          Empresa
          <input name="company" type="text" required />
        </label>
        <label>
          Actividad
          <input name="activity" type="text" required />
        </label>
        <label>
          Correo
          <input name="email" type="email" required />
        </label>
        <label>
          WhatsApp (opcional)
          <input name="whatsapp" type="tel" />
        </label>
        <label>
          Usuarios aproximados
          <input name="users" type="number" min="1" />
        </label>
      </div>
      <label>
        Herramientas actuales (opcional)
        <input name="tools" type="text" />
      </label>
      <div class="form-actions">
        <button
          class="button button-primary"
          type="submit"
          disabled={
            !publicContactEmail && !publicContactEndpoint && !publicWhatsappNumber
          }
        >
          {
            publicContactEndpoint || publicWhatsappNumber || publicContactEmail
              ? "Enviar y conversar"
              : "Envío pendiente"
          }
        </button>
        {
          showConfigNotice && (
            <p class="config-note" role="status">
              Configura PUBLIC_CONTACT_EMAIL, PUBLIC_CONTACT_ENDPOINT o
              PUBLIC_WHATSAPP_NUMBER para activar el envío desde el formulario.
            </p>
          )
        }
      </div>
      <p class="form-status" id="form-status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>
<Footer />

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const status = document.getElementById(
    "form-status",
  ) as HTMLParagraphElement | null;

  if (form && status) {
    const endpoint = form.dataset.contactEndpoint || "";
    const whatsappNumber = form.dataset.contactWhatsapp || "";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const fields = {
        problem: data.get("problem")?.toString().trim() || "",
        name: data.get("name")?.toString().trim() || "",
        company: data.get("company")?.toString().trim() || "",
        activity: data.get("activity")?.toString().trim() || "",
        email: data.get("email")?.toString().trim() || "",
        whatsapp: data.get("whatsapp")?.toString().trim() || "",
        users: data.get("users")?.toString().trim() || "",
        tools: data.get("tools")?.toString().trim() || "",
      };

      const missing = [
        fields.problem,
        fields.name,
        fields.company,
        fields.activity,
        fields.email,
      ].some((value) => !value);

      if (missing) {
        status.textContent =
          "Completá los campos obligatorios antes de enviar.";
        return;
      }

      // Try server endpoint first (if configured)
      if (endpoint) {
        try {
          status.textContent = "Enviando...";
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(fields),
          });
          if (res.ok) {
            status.textContent = "Gracias. Pronto nos contactaremos contigo.";
            form.reset();
          } else {
            status.textContent =
              "Ocurrió un error al enviar. Intentá nuevamente o contactanos por correo.";
          }
          return;
        } catch (err) {
          status.textContent =
            "Error de red. Intentá nuevamente o contactanos por correo.";
          return;
        }
      }

      // Next try WhatsApp if configured
      if (whatsappNumber) {
        const message = [
          `Consulta Aduken`,
          `Problema o proceso: ${fields.problem}`,
          `Nombre: ${fields.name}`,
          `Empresa: ${fields.company}`,
          `Actividad: ${fields.activity}`,
          `Correo: ${fields.email}`,
          `WhatsApp: ${fields.whatsapp || "No informado"}`,
          `Usuarios aproximados: ${fields.users || "No informado"}`,
          `Herramientas actuales: ${fields.tools || "No informado"}`,
        ].join("\n");

        const url = `https://wa.me/${encodeURIComponent(
          whatsappNumber,
        )}?text=${encodeURIComponent(message)}`;
        window.location.href = url;
        status.textContent =
          "Se abrirá WhatsApp para enviar tu mensaje con los detalles.";
        return;
      }

      // Fallback to mailto if no endpoint or WhatsApp
      const recipient = form.getAttribute("data-contact-email") || "";
      if (!recipient) {
        status.textContent =
          "El envío se habilitará cuando se configure PUBLIC_CONTACT_EMAIL, PUBLIC_CONTACT_ENDPOINT o PUBLIC_WHATSAPP_NUMBER.";
        return;
      }

      const subject = `Consulta Aduken — ${fields.name} (${fields.company})`;
      const body = [
        `Problema o proceso: ${fields.problem}`,
        `Nombre: ${fields.name}`,
        `Empresa: ${fields.company}`,
        `Actividad: ${fields.activity}`,
        `Correo: ${fields.email}`,
        `WhatsApp: ${fields.whatsapp || "No informado"}`,
        `Usuarios aproximados: ${fields.users || "No informado"}`,
        `Herramientas actuales: ${fields.tools || "No informado"}`,
      ].join("\n");

      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status.textContent =
        "Se abrirá tu cliente de correo para completar el envío.";
    });
  }
</script>
